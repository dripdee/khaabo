{
  "name": "khaabo",
  "compatibility_date": "2026-08-15",
  "assets": {
    "directory": "./frontend/dist",
    // Deep links like /trending or /dish/x must fall through to the SPA
    // (index.html) instead of 404ing — the Router renders client-side.
    // Pure static-assets site: no worker script needed.
    "not_found_handling": "single-page-application"
  }
}
