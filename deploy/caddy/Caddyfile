# Khaabo edge proxy.
#
# Caddy obtains and renews Let's Encrypt certificates automatically when the
# domain resolves to this host and ports 80/443 are reachable from the public
# internet. The `{$DOMAIN}` substitution comes from the container environment.

{
	admin off
	auto_https disable_redirects
	email {$DOMAIN_EMAIL:}
}

{$DOMAIN} {
	encode zstd gzip

	# Security headers — see docs/deployment.md §security headers rationale.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), interest-cohort=()"
		-cross-domain
		# CSP allows inline styles (Tailwind runtime) and the CDN fonts, and data:
		# images for Leaflet markers. Map tiles (OpenStreetMap) are https from *.tile.openstreetmap.org.
		Content-Security-Policy "default-src 'self'; \
			script-src 'self'; \
			style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; \
			font-src 'self' https://fonts.gstatic.com data:; \
			img-src 'self' data: https:; \
			connect-src 'self'; \
			frame-ancestors 'none'; \
			base-uri 'self'; \
			form-action 'self'"
		# Cached static assets and the HTML shell change per-deploy; s-maxage keeps
		# the CDN warm while we still revalidate in the browser.
		-Cache-Control
	}

	@api path /api/* /docs /redoc /openapi.json
	reverse_proxy @api {$API_UPSTREAM} {
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
		transport http {
			read_timeout 120s
			write_timeout 120s
		}
	}

	# Long-cache hashed assets (Vite emits content-hashed filenames).
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy {$WEB_UPSTREAM} {
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
	}

	# robots.txt and sitemap.xml served directly by the frontend, no extra rules.
}
