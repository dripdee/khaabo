# ── Core ─────────────────────────────────────────────────────────────────────
ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
LOG_JSON=false

# Required by the Nominatim/Overpass usage policies (sent in User-Agent)
CONTACT_EMAIL=you@example.com

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://khaabo:khaabo@localhost:5432/khaabo
SYNC_DATABASE_URL=postgresql+psycopg://khaabo:khaabo@localhost:5432/khaabo
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# ── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Cities ───────────────────────────────────────────────────────────────────
DEFAULT_CITY_SLUG=kolkata

# ── Supabase auth ────────────────────────────────────────────────────────────
# Never put the service_role key in the frontend or in git.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Either the HS256 JWT secret (Project Settings -> API -> JWT Secret) ...
SUPABASE_JWT_SECRET=
# ... or the JWKS URL for asymmetric keys (takes precedence when set)
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
# Development only: accept `Bearer dev:<email>` tokens. MUST be false in production.
AUTH_DEV_BYPASS=true

# ── Error monitoring (optional) ──────────────────────────────────────────────
# Leave empty to disable Sentry; the app boots fine without it.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.0

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_READ_PER_MINUTE=120
RATE_LIMIT_WRITE_PER_MINUTE=20
RATE_LIMIT_REVIEWS_PER_HOUR=5
RATE_LIMIT_REVIEWS_PER_DAY=20

# ── AI provider (all free options) ───────────────────────────────────────────
# heuristic | ollama | openai_compat
AI_PROVIDER=heuristic
AI_BATCH_SIZE=8
AI_TIMEOUT_SECONDS=60
AI_MIN_MENTION_CONFIDENCE=0.35
AI_ALLOW_DISH_CREATION=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Only if you point at a self-hosted OpenAI-compatible server
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# ── Sources ──────────────────────────────────────────────────────────────────
SOURCES_ENABLED=osm,user
SOURCE_INTERVAL_OSM_HOURS=24
SOURCE_INTERVAL_REDDIT_HOURS=6
SOURCE_INTERVAL_YOUTUBE_HOURS=24

OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_FALLBACK_URLS=https://overpass.kumi.systems/api/interpreter
OVERPASS_MIN_INTERVAL_SECONDS=2
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_MIN_INTERVAL_SECONDS=1

# Reddit: create a "script" app at https://www.reddit.com/prefs/apps (free)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=khaabo/0.1 (by /u/yourname)
REDDIT_SUBREDDITS=kolkata,india,IndianFood
REDDIT_REQUESTS_PER_MINUTE=55

# YouTube Data API v3 key (free quota: 10000 units/day)
YOUTUBE_API_KEY=
YOUTUBE_DAILY_QUOTA_UNITS=9000
YOUTUBE_MAX_VIDEOS_PER_RUN=25

# Google Places API (New) — Nearby Search Pro: 35,000 requests/month free on an
# India billing profile. The guard stops the sweep at GOOGLE_PLACES_MONTHLY_LIMIT.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_MONTHLY_LIMIT=30000
GOOGLE_PLACES_MAX_REQUESTS_PER_RUN=2500
GOOGLE_REFRESH_INTERVAL_HOURS=720

# ── Ranking weights (must sum to 1.0) ────────────────────────────────────────
RANKING_W_SENTIMENT=0.35
RANKING_W_RECENCY=0.20
RANKING_W_CONSISTENCY=0.15
RANKING_W_VOLUME=0.10
RANKING_W_SOURCE_QUALITY=0.10
RANKING_W_ENGAGEMENT=0.05
RANKING_W_CONFIDENCE=0.05
RANKING_WEIGHTS_VERSION=v1
RANKING_HALFLIFE_DAYS=180
RANKING_BAYES_M=6.0
RANKING_BAYES_PRIOR=0.62
RANKING_VOLUME_SATURATION=50
RANKING_MIN_MENTIONS=3
RANKING_MIN_WEIGHT=1.5
SNAPSHOT_SCORE_DELTA=0.5
SNAPSHOT_MENTION_DELTA=2

# ── Trends ───────────────────────────────────────────────────────────────────
TREND_RECENT_DAYS=60
TREND_HISTORICAL_DAYS=240
TREND_DELTA_THRESHOLD=0.08
TREND_MIN_OBSERVATIONS=3

# ── Search / cache ───────────────────────────────────────────────────────────
SEARCH_BACKEND=postgres
CACHE_ENABLED=true
CACHE_TTL_SEARCH=120
CACHE_TTL_DISH=300
CACHE_TTL_TRENDING=900

# ── Frontend (safe to expose) ────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_DEFAULT_CITY=kolkata

# ── Edge proxy (free-tier and prod overlays) ────────────────────────────────
# Caddy's {$DOMAIN} substitution — the hostname Caddy terminates TLS for.
# In dev: leave empty (no Caddy). In prod/free-tier: the api subdomain.
DOMAIN=api.khaabo.in
# Free-tier only — the Cloudflare Pages URL Caddy 308-redirects unmatched
# paths to. Ignored by the prod overlay.
PAGES_URL=https://khaabo.in
